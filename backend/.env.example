# Copy to backend/.env. Keep existing credentials on an existing installation.
POSTGRES_USER=racelith_user
POSTGRES_PASSWORD=replace_this_with_a_long_random_password
POSTGRES_DB=racelith_db
DATABASE_URL=postgresql://racelith_user:${POSTGRES_PASSWORD}@db:5432/racelith_db

# Browser origins for local use. Add your computer's LAN URL for other devices.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
WARNING_EXPIRY_MINUTES=180
